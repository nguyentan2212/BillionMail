# Fork/source version.
BILLIONMAIL_CONFIG_VERSION=v4.9
BILLIONMAIL_CORE_VERSION=4.9.3

# Persistent configuration sync.
# missing: add new upstream config files without overwriting existing files.
# none: never copy config after the first deployment.
# overwrite: replace persistent config from the fork; back up first.
BILLIONMAIL_CONFIG_SYNC=missing

# Normally false because BillionMail edits its persistent .env from the UI.
# Set true for one intentional deployment only when rebuilding the whole file.
BILLIONMAIL_ENV_RECREATE=false

BILLIONMAIL_HOSTNAME=mail.example.com

ADMIN_USERNAME=mia-mail-admin
ADMIN_PASSWORD=REPLACE_WITH_OPENSSL_RAND_HEX_24
SafePath=REPLACE_WITH_OPENSSL_RAND_HEX_12

# External PostgreSQL. DBHOST must be reachable from the BillionMail containers.
DBHOST=postgres.internal.example.com
DBPORT=5432
DBNAME=billionmail
DBUSER=billionmail
DBPASS=REPLACE_WITH_OPENSSL_RAND_HEX_32
# disable, allow, prefer, require, verify-ca, or verify-full.
DB_SSLMODE=disable

# External Redis. The simplified Rspamd integration requires a private
# plaintext Redis endpoint; keep REDIS_TLS=false unless Rspamd is changed to
# use a separate TLS tunnel.
REDISHOST=redis.internal.example.com
REDISPORT=6379
REDISUSER=
REDISPASS=REPLACE_WITH_OPENSSL_RAND_HEX_32
# BillionMail Core uses REDISDB; Rspamd normally uses database 0.
REDISDB=1
RSPAMD_REDISDB=0
REDIS_TLS=false
REDIS_TLS_VERIFY=required
REDIS_TLS_SERVER_NAME=

SMTP_PORT=25
SMTPS_PORT=465
SUBMISSION_PORT=587
IMAP_PORT=143
IMAPS_PORT=993
POP_PORT=110
POPS_PORT=995

# Internal listeners only. Dokploy Traefik owns host ports 80/443.
HTTP_PORT=8080
HTTPS_PORT=8443

WEB_BASE_PATH=
AAPANEL_SSO_SECRET=
TZ=Asia/Ho_Chi_Minh
IPV4_NETWORK=10.89.0
FAIL2BAN_INIT=y
IP_WHITELIST_ENABLE=false
RETENTION_DAYS=7
