# Fork/source version. Base the fork branch on the same stable tag.
BILLIONMAIL_CONFIG_VERSION=v4.9
BILLIONMAIL_CORE_VERSION=4.9.3

# Safe defaults for later redeployments.
# missing: add new config files but do not overwrite existing files.
# none: never copy config after the first deployment.
# overwrite: replace persistent config from the fork; backup first.
BILLIONMAIL_CONFIG_SYNC=missing

# Normally false because BillionMail itself can edit the persistent .env.
# Set true for ONE intentional deployment only when rebuilding it from Dokploy.
BILLIONMAIL_ENV_RECREATE=false

BILLIONMAIL_HOSTNAME=mail.example.com

ADMIN_USERNAME=mia-mail-admin
ADMIN_PASSWORD=REPLACE_WITH_OPENSSL_RAND_HEX_24
SafePath=REPLACE_WITH_OPENSSL_RAND_HEX_12

DBNAME=billionmail
DBUSER=billionmail
DBPASS=REPLACE_WITH_OPENSSL_RAND_HEX_32

# Data service mode. local-db starts both bundled PostgreSQL and bundled Redis.
# To use external PostgreSQL and external Redis together, leave this empty.
COMPOSE_PROFILES=local-db

# PostgreSQL upstream used by the internal PgBouncer gateway.
DBHOST=pgsql-billionmail
DBPORT=5432
DB_SSLMODE=disable
DB_POOL_MODE=session
DB_MAX_CLIENT_CONN=200
DB_DEFAULT_POOL_SIZE=20

# Redis upstream used by the internal Redis gateway.
# BillionMail clients continue to use redis:6379 internally.
REDISHOST=redis-billionmail
REDISPORT=6379
REDISPASS=REPLACE_WITH_OPENSSL_RAND_HEX_32
REDISDB=1
REDIS_TLS=false
REDIS_TLS_VERIFY=required
REDIS_TLS_SERVER_NAME=

SMTP_PORT=25
SMTPS_PORT=465
SUBMISSION_PORT=587
IMAP_PORT=143
IMAPS_PORT=993
POP_PORT=110
POPS_PORT=995

# Internal listeners only. Dokploy Traefik owns host ports 80/443.
HTTP_PORT=8080
HTTPS_PORT=8443

WEB_BASE_PATH=
AAPANEL_SSO_SECRET=
TZ=Asia/Ho_Chi_Minh
IPV4_NETWORK=10.89.0
FAIL2BAN_INIT=y
IP_WHITELIST_ENABLE=false
RETENTION_DAYS=7
